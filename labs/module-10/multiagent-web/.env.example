# Copy this file to .env, set LLM_PROVIDER, and fill in the block for each provider you want on the canvas
# Never commit .env to git
# The names match the repo-root .env (labs/setup/.env.example), so that file works here too

# Which provider an agent uses when its own "Provider" setting is left on "Default": openai | anthropic | azure-openai | azure-anthropic
LLM_PROVIDER=openai

# Safety limit: the largest number of agent runs one workflow may use (default 12, the editor allows 3 to 30)
# MAX_STEPS=12

# --- openai (OpenAI API) ---
OPENAI_API_KEY=your_openai_key_here
OPENAI_MODEL=gpt-6.1-sol
# Optional: the "Small (faster)" tier an agent can pick; without it that tier uses OPENAI_MODEL
OPENAI_SMALL_MODEL=gpt-5-mini
# Optional, OpenAI reasoning models only: a low effort shortens the wait before the first token.
# Leave empty for the model's default; valid values depend on the model.
OPENAI_REASONING_EFFORT=

# --- anthropic (Claude API) ---
ANTHROPIC_API_KEY=your_anthropic_key_here
ANTHROPIC_MODEL=claude-opus-5-5
ANTHROPIC_SMALL_MODEL=claude-haiku-5-5

# --- azure-openai (Azure OpenAI) ---
AZURE_OPENAI_API_KEY=your_azure_openai_key_here
# Resource endpoint only, no path (Azure portal > your resource > Keys and Endpoint)
AZURE_OPENAI_ENDPOINT=https://your-resource-name.openai.azure.com
# Your deployment names, not the base model names
AZURE_OPENAI_DEPLOYMENT=your_deployment_name_here
AZURE_OPENAI_SMALL_DEPLOYMENT=

# --- azure-anthropic (Claude on Microsoft Foundry) ---
ANTHROPIC_FOUNDRY_API_KEY=your_azure_foundry_key_here
# Resource name only: the <resource> part of https://<resource>.services.ai.azure.com
ANTHROPIC_FOUNDRY_RESOURCE=your-resource-name
# Your deployment name, not the base model name (often the same, e.g. claude-opus-5-5)
ANTHROPIC_FOUNDRY_DEPLOYMENT=your_deployment_name_here
ANTHROPIC_FOUNDRY_SMALL_DEPLOYMENT=
